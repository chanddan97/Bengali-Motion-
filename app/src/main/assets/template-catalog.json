  "templates": [
    {
      "id": "minimal-text",
      "name": "Minimal Text",
      "origin": "observed-label-original-design",
      "category": [
        "text"
      ],
      "description": "Clean headline layout with large Bengali-safe text and whitespace.",
      "aspectRatios": [
        "9:16",
        "1:1",
        "4:5",
        "16:9"
      ],
      "layers": [
        {
          "id": "background",
          "type": "shape",
          "role": "background",
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1,
          "opacity": 1.0,
          "textStyle": {
            "fillToken": "surface-background"
          }
        },
        {
          "id": "headline",
          "type": "text",
          "role": "headline",
          "x": 0.08,
          "y": 0.3,
          "width": 0.84,
          "height": 0.22,
          "opacity": 1.0,
          "textStyle": {
            "fontFamily": "Noto Sans Bengali",
            "fontWeight": "bold",
            "maxLines": 3,
            "alignment": "center"
          }
        },
        {
          "id": "caption",
          "type": "text",
          "role": "caption",
          "x": 0.1,
          "y": 0.58,
          "width": 0.8,
          "height": 0.14,
          "opacity": 0.92,
          "textStyle": {
            "fontFamily": "Noto Sans Bengali",
            "fontWeight": "regular",
            "maxLines": 3,
            "alignment": "center"
          }
        }
      ],
      "motion": [
        {
          "type": "fade",
          "durationMs": 350,
          "delayMs": 0
        },
        {
          "type": "slide-up",
          "durationMs": 500,
          "delayMs": 100
        }
      ],
      "accessibility": {
        "minimumContrastNote": "Use high-contrast foreground/background tokens and test Bengali glyph rendering.",
        "bengaliTextSafe": true,
        "reducedMotionSupported": true
      }
    },
